# GitHub organization that owns the runner
ORG_NAME=xxxxx

# GitHub PAT with organization "Self-hosted runners: write" permission
ACCESS_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxx

# Optional runner naming
RUNNER_NAME_PREFIX=xxx-worker-xxx
# Optional exact name; when unset, the prefix gets an eight-character UUID suffix
# RUNNER_NAME=my-runner

# Labels used to target this runner in GitHub Actions
RUNNER_LABELS=self-hosted,linux,x64,development

# Runner working directory inside the container
RUNNER_WORKDIR=_work
